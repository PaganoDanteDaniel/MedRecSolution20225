<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <Platform>x64</Platform>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="logo_medrec.png" />
  </ItemGroup>
  <!-- Paquetes y payloads -->
  <ItemGroup>
    <!-- Extensión para la interfaz de usuario -->
    <PackageReference Include="WixToolset.Bal.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
    <ProjectReference Include="..\MedRec.Installer.MSI\MedRec.Installer.MSI.wixproj" />
    <!-- Archivo de localización en español -->
    <WixBundlePayload Include="es-es.wxl" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="redist\" />
  </ItemGroup>
</Project>