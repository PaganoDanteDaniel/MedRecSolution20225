@using MedRec.CommonComponents.Views
@using MedRec.CommonComponents.Views.Components
@using MedRec.Entity.DTOs
@using MedRec.HealthInsurance.ViewModels.VM
@using MedRec.HealthInsurance.ViewModels.Models
@using MedRec.HealthInsurance.Views.Resources
@using Microsoft.AspNetCore.Components.Forms
@using System.Runtime.CompilerServices

@inherits OwningComponentBase<HealthInsuranceCatalogVM>

<div class="container">
    <div class="search-section">
        <SearchAndAddComponent LabelText="@HealthInsuranceMessages.FilterLabelText"
                               Placeholder="@HealthInsuranceMessages.PlaceholderFilterInput"
                               ButtonText="AGREGAR"
                               @bind-Value="Filter"
                               OnButtonClick="OnAddHealthInsurance"
                               ShowButton />
    </div>
    <div class="table-container">
        <TableComponent TItem="HealthInsuranceModel"
                        Items="VM.HealthInsuranceCatalog.ToList()"
                        OnRowClick="SelectHealthInsurance"
                        OnEdit="OnUpdateHealthInsurance"
                        OnDelete="OnDeleteHealthInsurance">
            <FullHeaderTemplate>
                <thead>
                    <tr>
                        <th style="width: 12%;" scope="col">Sigla</th>
                        <th scope="col">Nombre</th>
                        <th class="actions" style="width: 12%;" scope="col">Acciones</th>
                    </tr>
                </thead>
            </FullHeaderTemplate>
            <RowTemplate Context="healthInsurance">
                <td style="width:12%;"><span class="truncate">@healthInsurance.Acronym</span></td>
                <td style="width: 100%;"><span class="truncate">@healthInsurance.Name</span></td>
            </RowTemplate>
        </TableComponent>
    </div>
    <div class="pagination-section">
        <PaginationComponent CurrentPage="@_paginationDto.CurrentPage"
                             TotalPages="@_totalPages"
                             MaxPageButton="@MaxPageButton"
                             PageChanged="HandlePageChanged" />
    </div>
</div>


<MdMessageModal Visible="@ModalVisible"
                VisibleChanged="@(v => ModalVisible = v)"
                Type="@ModalType"
                Title="@ModalTitle"
                Message="@ModalMessage"
                Body="@ModalBody"
                CloseOnOverlayClick="@CloseOnOverlayClick"
                ShowOk="@ShowOk"
                ShowCancel="@ShowCancel"
                ShowDelete="@ShowDelete"
                ShowRetry="@ShowRetry"
                OnOk="_onOkCallback"
                OnCancel="_onCancelCallback"
                OnDelete="_onDeleteCallback"
                OnRetry="_onRetryCallback" />

@code {
    private UpdateHealthInsuranceComponent? _updateComponentRef;
    private AddHealthInsuranceComponent? _addComponentRef;
    private CancellationTokenSource _cts;
    private CancellationTokenSource _debounceCts;
    [Inject] public NavigationManager NavigationManager { get; set; }
    private HealthInsuranceCatalogVM VM => Service;
    [Parameter] public EventCallback<(Guid Id, string Name)> OnHealthCompanySelected { get; set; }
    [Parameter] public EventCallback<string> FooterMessageParameterChanged { get; set; }
    [Parameter] public int MaxPageButton { get; set; }

    [Parameter]
    public string FooterMessage
    {
        get => _footerMessage;
        set
        {
            if (_footerMessage != value)
            {
                _footerMessage = value;
                FooterMessageParameterChanged.InvokeAsync(value);
            }
        }
    }

    private string Filter
    {
        get => _paginationDto.FilterOne;
        set
        {
            if (_paginationDto.FilterOne != value)
            {
                _paginationDto.FilterOne = value;
                _ = OnSearchTermChanged(value);
            }
        }
    }

    private PaginationDto _paginationDto = new(1, 10);
    private int _totalPages = 1;

    // === NUEVAS PROPIEDADES PARA EL NUEVO MODAL ===
    private bool ModalVisible;
    private ModalType ModalType = ModalType.MessageInfo;
    private string ModalTitle = "Mensaje";
    private string ModalMessage = "";
    private RenderFragment? ModalBody;
    private bool CloseOnOverlayClick = true;
    private bool ShowOk = false;
    private bool ShowCancel = false;
    private bool ShowDelete = false;
    private bool ShowRetry = false;

    // Callbacks para el nuevo modal
    private EventCallback _onOkCallback = default;
    private EventCallback _onCancelCallback = default;
    private EventCallback _onDeleteCallback = default;
    private EventCallback _onRetryCallback = default;

    // Estado de acciones
    private Guid healthCompanyId;
    private bool _addAction;
    private bool _deleteAction;
    private bool _updateAction;
    private string _footerMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // Suscribir eventos del VM al nuevo sistema de modales
        VM.OnShowMessage += () => ShowInfoModal("Información", VM.InformationMessage);
        VM.OnShowWarning += () => ShowWarningModal("Advertencia", VM.InformationMessage);
        VM.OnShowError += () => ShowErrorModal("Error", VM.InformationMessage);
        VM.OnShowConcurrencyError += () => ShowErrorModal("Conflicto de concurrencia", VM.InformationMessage);
        VM.OnHealthInsuranceDeleted += StateHasChanged;

        await LoadHealthCompanies();
    }

    private async Task OnSearchTermChanged(string searchTerm)
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();

        if (searchTerm.Length > 2 || searchTerm.Length == 0)
        {
            try
            {
                await Task.Delay(600, _debounceCts.Token);
                _paginationDto.CurrentPage = 1;
                await LoadHealthCompanies();
            }
            catch (TaskCanceledException) { }
        }
    }

    private async Task SelectHealthInsurance(HealthInsuranceModel healthInsurance)
    {
        await OnHealthCompanySelected.InvokeAsync((healthInsurance.Id, healthInsurance.Name));
    }

    private async Task LoadHealthCompanies()
    {
        _cts?.Dispose();
        _cts = new CancellationTokenSource();

        await VM.GetHealthInsuranceAsync(_paginationDto, _cts.Token);
        var total = VM.TotalRecords;
        FooterMessage = string.Format(HealthInsuranceMessages.TotalRegistryTemplate, total);
        _totalPages = (int)Math.Ceiling((double)total / _paginationDto.PageSize);
        StateHasChanged();
    }

    private async Task HandlePageChanged(int newPage)
    {
        _paginationDto.CurrentPage = newPage;
        await LoadHealthCompanies();
    }

    // === FLUJOS DE USUARIO ===

    private void OnAddHealthInsurance()
    {
        ResetButtons();
        _addAction = true;
        ModalTitle = AddHealthInsuranceMessages.TitleText;
        ModalType = ModalType.NormalContent;
        ModalBody = builder =>
        {
            builder.OpenComponent<AddHealthInsuranceComponent>(0);
            builder.AddAttribute(1, nameof(AddHealthInsuranceComponent.CompanyName), "");
            builder.AddAttribute(2, nameof(AddHealthInsuranceComponent.CompanyAcronym), "");
            builder.AddAttribute(3, nameof(AddHealthInsuranceComponent.OnHealthInsuranceCreated),
                EventCallback.Factory.Create(this, OnHealthCompanyAdded));
            builder.AddComponentReferenceCapture(4, inst => _addComponentRef = (AddHealthInsuranceComponent?)inst);
            builder.CloseComponent();
        };
        ShowOk = true;
        ShowCancel = true;
        CloseOnOverlayClick = false;
        _onOkCallback = EventCallback.Factory.Create(this, HandleCreateOk);
        ModalVisible = true;
    }

    private void OnUpdateHealthInsurance(HealthInsuranceModel healthCompany)
    {
        ResetButtons();
        _updateAction = true;
        healthCompanyId = healthCompany.Id;
        ModalTitle = UpdateHealthInsuranceMessages.TitleText;
        ModalType = ModalType.NormalContent;

        ModalBody = builder =>
        {
            builder.OpenComponent<UpdateHealthInsuranceComponent>(0);
            builder.AddAttribute(1, nameof(UpdateHealthInsuranceComponent.HealthInsuranceId), healthCompanyId);
            builder.AddAttribute(2, nameof(UpdateHealthInsuranceComponent.OnHealthInsuranceUpdated),
                EventCallback.Factory.Create(this, OnHealthCompanyUpdated));
            builder.AddComponentReferenceCapture(3, inst => _updateComponentRef = (UpdateHealthInsuranceComponent?)inst);
            builder.CloseComponent();
        };

        ShowOk = true;
        ShowCancel = true;
        CloseOnOverlayClick = false;
        _onOkCallback = EventCallback.Factory.Create(this, HandleUpdateOk);
        _onCancelCallback = EventCallback.Factory.Create(this, HandleUpdateCancel);
        ModalVisible = true;
    }

    private void OnDeleteHealthInsurance(HealthInsuranceModel healthCompany)
    {
        ResetButtons();
        _deleteAction = true;
        healthCompanyId = healthCompany.Id;
        VM.InformationMessage = HealthInsuranceMessages.ModalMessageText;

        ModalTitle = HealthInsuranceMessages.ModalTitleText;
        ModalType = ModalType.MessageDanger;
        ModalMessage=VM.InformationMessage;

        ShowDelete = true;
        ShowCancel = true;
        CloseOnOverlayClick = false;
        _onDeleteCallback = EventCallback.Factory.Create(this, OnAcceptDelete);
        _onCancelCallback = EventCallback.Factory.Create(this, OnCloseModal);
        ModalVisible = true;
    }

    private async Task OnAcceptDelete()
    {
        try
        {
            await VM.DeleteHealthInsuranceAsync(healthCompanyId);
            await LoadHealthCompanies();
        }
        // catch (ConcurrencyException)
        // {
        //     VM.OnShowConcurrencyError?.Invoke();
        // }
        // catch (Exception ex)
        // {
        //     VM.OnShowError?.Invoke();
        // }
        finally
        {
            _deleteAction = false;
            ModalVisible = false;
        }
    }
    private async Task HandleCreateOk()
    {
        if(_addComponentRef is not null)
        {
            await _addComponentRef.SaveAsync();
        }
    }

    private async Task HandleUpdateOk()
    {
        if (_updateComponentRef is not null)
        {
            // Validamos y guardamos
            await _updateComponentRef.SaveAsync();
            // NOTA: SaveAsync ya llama a OnHealthInsuranceUpdated,
            // que a su vez llama a OnHealthCompanyUpdated → cierra el modal y refresca.
            // Así que no necesitamos cerrar aquí explícitamente.
        }
    }

    private void HandleUpdateCancel()
    {
        // Opcional: limpiar campos antes de cerrar
        _updateComponentRef?.CleanField();

        // Cerrar modal
        OnCloseModal();
    }
    // === CIERRE Y LIMPIEZA ===

    private void OnCloseModal()
    {
        _addAction = false;
        _updateAction = false;
        _deleteAction = false;
        ModalVisible = false;
    }

    private async Task OnHealthCompanyAdded()
    {
        _addAction = false;
        await LoadHealthCompanies();
        ModalVisible = false;
    }

    private async Task OnHealthCompanyUpdated()
    {
        _updateAction = false;
        await LoadHealthCompanies();
        ModalVisible = false;
    }

    private void OnCancelAdder()
    {
        OnCloseModal();
    }

    // === MÉTODOS AUXILIARES PARA MENSAJES SIMPLES ===

    private void ShowInfoModal(string title, string message)
    {
        ModalTitle = title;
        ModalType = ModalType.MessageInfo;
        ModalMessage = message;
        ShowOk = true;
        CloseOnOverlayClick = true;
        ModalVisible = true;
    }

    private void ShowWarningModal(string title, string message)
    {
        ModalTitle = title;
        ModalType = ModalType.MessageWarning;
        ModalMessage = message;
        ShowOk = true;
        CloseOnOverlayClick = true;
        ModalVisible = true;
    }

    private void ShowErrorModal(string title, string message)
    {
        ModalTitle = title;
        ModalType = ModalType.MessageError;
        ModalMessage = message;
        ShowOk = true;
        CloseOnOverlayClick = true;
        ModalVisible = true;
    }

    void ResetButtons()
    {
        ShowOk = false;
        ShowCancel = false;
        ShowRetry = false;
        ShowDelete = false;
        ModalBody = null;
    }

    public void Dispose()
    {
        if (VM is not null)
        {
            // Desuscribir eventos
            VM.OnShowMessage -= () => ShowInfoModal("Información", VM.InformationMessage);
            VM.OnShowWarning -= () => ShowWarningModal("Advertencia", VM.InformationMessage);
            VM.OnShowError -= () => ShowErrorModal("Error", VM.InformationMessage);
            VM.OnShowConcurrencyError -= () => ShowErrorModal("Conflicto de concurrencia", VM.InformationMessage);
            VM.OnHealthInsuranceDeleted -= StateHasChanged;
        }
        _cts?.Dispose();
        _debounceCts?.Dispose();
    }
}