@page "/health-insurance-catalog"
@using MedRec.CommonComponents.Views.Components
@using MedRec.CommonComponents.Views.Exceptions
@using MedRec.HealthInsurance.ViewModels.VM
@using MedRec.HealthInsurance.Views.Components
@using MedRec.HealthInsurance.Views.Resources
@using Microsoft.AspNetCore.Components.Web
<div class="body-content">
    <TitleComponent Title="@HealthInsuranceMessages.TitleText" />

    <!-- Zona desplazable -->
    <div class="scrollable-section">
        <ErrorBoundary @ref=ErrorBoundaryRef>
            <ChildContent>
                <HealthInsuranceComponent
                    MaxPageButton="MaxPageButton"
                    FooterMessageParameterChanged="OnMessageFooterChange"
                    OnHealthCompanySelected="SelectedHealthCompany"/>
            </ChildContent>
            <ErrorContent>
                <ExceptionDisplayComponent Exception="context" />
                <button class="btn btn-danger" @onclick=Recover>OK</button>
            </ErrorContent>
        </ErrorBoundary>
    </div>

    <!-- Footer fijo -->
    <div class="me-footer">
        <FooterComponent Message="@footerMessage" />
    </div>
</div>

<style>
    :host {
        display: flex;
        flex-direction: column;
        height: 100vh; /* ocupa toda la altura visible de la ventana */
        overflow: hidden; /* evita scroll global */
    }

    /* contenedor principal */
    .body-content {
        display: flex;
        flex-direction: column;
        flex: 1;
        overflow: hidden; /* para que el scroll solo sea interno */
    }

    /* sección que scrollea */
    .scrollable-section {
        flex: 1;
        overflow-y: auto;
        padding: 1rem;
        box-sizing: border-box;
    }

    /* footer fijo al fondo */
    .me-footer {
        flex-shrink: 0;
        border-top: 1px solid #ddd;
        padding: 0.75rem 1rem;
        background-color: #f9f9f9;
        text-align: center;
    }
</style>