@typeparam TItem
<div class="my-table-container">
    <table class="ptbl-table">
        @if (ColGroup is not null)
        {
            @ColGroup
        }

        @if (FullHeaderTemplate is not null)
        {
            @FullHeaderTemplate
        }
        else
        {
            <thead>
                <tr>
                    @TableHeader
                </tr>
            </thead>
        }

        <tbody>
            @foreach (var item in Items)
            {
                var rowClass = rowIndex % 2 == 0 ? "table-row-even" : "table-row-odd";
                <tr @onclick='() => OnRowClick.InvokeAsync(item)' class="@rowClass">
                    @RowTemplate(item)

                    <td class="actions " @onclick:stopPropagation>
                        <a href="javascript:void(0);" @onclick='() => OnEdit.InvokeAsync(item)' title="Editar">
                            <i class="bi bi-pencil-square" data-bs-toggle="tooltip" data-bs-placement="top"></i>
                        </a>

                        <a href="javascript:void(0);" @onclick='() => OnDelete.InvokeAsync(item)' title="Eliminar">
                            <i class="bi bi-trash-fill" data-bs-toggle="tooltip" data-bs-placement="top"></i>
                        </a>

                        @if (AdditionalAction is not null)
                        {
                            @AdditionalAction(item)
                        }
                    </td>
                </tr>
                rowIndex++;
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public IReadOnlyList<TItem> Items { get; set; } = new List<TItem>();
    [Parameter] public RenderFragment<TItem> RowTemplate { get; set; } = default!;

    // NUEVOS PARAMETROS
    [Parameter] public RenderFragment? ColGroup { get; set; } // Parámetro para <colgroup>
    [Parameter] public RenderFragment? FullHeaderTemplate { get; set; } // Parámetro para <thead> completo

    // Parámetros existentes
    [Parameter] public RenderFragment? TableHeader { get; set; }
    [Parameter] public EventCallback<TItem> OnRowClick { get; set; }
    [Parameter] public EventCallback<TItem> OnEdit { get; set; }
    [Parameter] public EventCallback<TItem> OnDelete { get; set; }
    [Parameter] public RenderFragment<TItem>? AdditionalAction { get; set; }
    int rowIndex = 0;
}
