@using MedRec.CommonComponents.Views.Components
@using MedRec.Entity.DTOs
@using MedRec.Entity.Enums
@using MedRec.Entity.Extensions
@using MedRec.MedicalVisit.ViewModels.Models
@using MedRec.MedicalVisit.ViewModels.VM

@functions {
    string Truncate(string text, int maxLength) =>
        string.IsNullOrEmpty(text) ? "" :
        text.Length > maxLength ? text.Substring(0, maxLength) + "..." : text;

    string DecodeBase64(string encoded) =>
        string.IsNullOrEmpty(encoded) ? "" : System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(encoded));
}
<div class="search-container">
           <SearchAndAddComponent LabelText="FILTROS DE VISITA:"
                             
                    Placeholder="BUSCAR MOTIVO, DIAGNÓSTICO, TRATAMIENTO O NOTAS..."
                    ButtonText="REGISTRAR VISITA"
                    @bind-Value="TextFilter"
                    OnButtonClick="OnButtonClick"/>

</div>
<div class="visit-history">

    @if (VM.IsLoading)
    {
        <p>Cargando visitas...</p>
    }
    else if (VM.LastError != null)
    {
        <p class="text-danger">@VM.LastError.Message</p>
    }
    else if (!VM.Visits.Any())
    {
        <p>No hay visitas registradas para este paciente.</p>
    }
    else
    {
        <div class="visit-cards">
            @foreach (var visit in VM.Visits)
            {
                <div class="visit-card" @onclick="() => OnVisitSelected.InvokeAsync(visit)">
                    <div class="card-header">
                        <strong>@visit.VisitDate.ToString("dd/MM/yyyy")</strong>
                    </div>
                    <div class="card-body">
                        <p><strong>Razón:</strong> @visit.Reason</p>
                        @if (!string.IsNullOrEmpty(visit.Notes))
                        {
                            <p><strong>Notas:</strong> @Truncate(visit.Notes, 120)</p>
                        }
                    </div>
                </div>
            }
        </div>
    }

</div>
@code{
    #region Inyeccion de dependencias
    [Inject] private NavigationManager Navigation { get; set; }
    #endregion

    #region Parámetros
    [Parameter] public MedicalVisitVM VM { get; set; }
    [Parameter] public EventCallback<MedicalVisitModel> OnVisitSelected { get; set; }
    [Parameter] public Guid PatientId { get; set; }
    [Parameter] public string PatientName { get; set; }
    [Parameter] public DateTime DateOfBirth { get; set; }
    #endregion

    #region Campos
    private CancellationTokenSource _debounceCts;
    private PaginationDto _paginationDto = new(1, 100);
    private List<SelectOptionDto> _visitReasonOptions = new();
    #endregion

    #region Propiedades
    private string TextFilter
    {
        get => _paginationDto.FilterOne;
        set
        {
            if (_paginationDto.FilterOne != value)
            {
                _paginationDto.FilterOne = value;
                // Llamar al método de debounce cada vez que el valor cambia
                _ = OnSearchTermChanged(value);
            }
        }
    }
    #endregion
    protected override async Task OnInitializedAsync()
    {
        _visitReasonOptions = Enum.GetValues<VisitReason>()
        .Select(r => new SelectOptionDto
        {
            Value = r.ToString(),
            Text = r.GetDescription()
        })
        .ToList();

        await LoadVisits();
    }
    private void OnButtonClick()
    {

        var url = $"/medical-visit/create/{PatientId}";

        Navigation.NavigateTo(url, true);
    }

    private async Task OnSearchTermChanged(string searchTerm)
    {
        // Cancelar la búsqueda anterior si existe
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();

        // Solo buscar si hay más de 2 caracteres o está vacío
        if (searchTerm.Length > 2 || searchTerm.Length == 0)
        {
            try
            {
                // Esperar 600ms antes de buscar
                await Task.Delay(600, _debounceCts.Token);
                _paginationDto.CurrentPage = 1;
                await LoadVisits();
            }
            catch (TaskCanceledException)
            {
                // Ignorar si se cancela por nueva entrada
            }
        }
    }
    private async Task LoadVisits()
    {
        await VM.LoadVisitsAsync(PatientId, _paginationDto);
        StateHasChanged();
    }
}