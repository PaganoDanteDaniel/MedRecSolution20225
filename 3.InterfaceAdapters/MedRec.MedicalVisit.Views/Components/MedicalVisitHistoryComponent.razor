@using MedRec.CommonComponents.Views.Components
@using MedRec.Entity.Extensions
@using MedRec.MedicalVisit.ViewModels.Models
@using MedRec.MedicalVisit.ViewModels.VM

@functions {
    string Truncate(string text, int maxLength) =>
        string.IsNullOrEmpty(text) ? "" :
        text.Length > maxLength ? text.Substring(0, maxLength) + "..." : text;

    string DecodeBase64(string encoded) =>
        string.IsNullOrEmpty(encoded) ? "" : System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(encoded));
}
<div class="search-container">
@*     <SearchAndAddComponent LabelText="RAZÓN DE VISITA:"
                           ButtonText="REGISTRAR VISITA"
                           EnumOptions="_visitReasonOptions"
                           @bind-SelectedEnumValue="SelectedVisitReason"
                           OnButtonClick="OnButtonClick"
                           ShowButton /> *@

           <SearchAndAddComponent LabelText="FILTROS DE VISITA:"
                           Placeholder="BUSCAR DIAGNÓSTICO, TRATAMIENTO O NOTAS..."
                           EnumPlaceholder="FILTRAR POR RAZÓN DE VISITA..."
                               ButtonText="REGISTRAR VISITA"
                               @bind-Value="TextFilter"
                               EnumOptions="_visitReasonOptions" 
                               @bind-SelectedEnumValue="SelectedVisitReason"
                               OnButtonClick="OnButtonClick"/>

</div>
<div class="visit-history">

    @if (VM.IsLoading)
    {
        <p>Cargando visitas...</p>
    }
    else if (VM.LastError != null)
    {
        <p class="text-danger">@VM.LastError.Message</p>
    }
    else if (!VM.Visits.Any())
    {
        <p>No hay visitas registradas para este paciente.</p>
    }
    else
    {
        <div class="visit-cards">
            @foreach (var visit in VM.Visits)
            {
                <div class="visit-card" @onclick="() => OnVisitSelected.InvokeAsync(visit)">
                    <div class="card-header">
                        <strong>@visit.VisitDate.ToString("dd/MM/yyyy")</strong>
                    </div>
                    <div class="card-body">
                        <p><strong>Razón:</strong> @visit.Reason.GetDescription()</p>
                       @*  <p><strong>Diagnóstico:</strong> @Truncate(visit.Diagnosis, 120)</p>
                        <p><strong>Tratamiento:</strong> @Truncate(visit.Treatment, 120)</p> *@
                        @if (!string.IsNullOrEmpty(visit.Notes))
                        {
                            <p><strong>Notas:</strong> @Truncate(visit.Notes, 120)</p>
                        }
                    </div>
                </div>
            }
        </div>
    }

</div>
