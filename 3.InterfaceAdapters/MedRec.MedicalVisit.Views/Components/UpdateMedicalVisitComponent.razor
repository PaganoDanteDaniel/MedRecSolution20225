@using MedRec.CommonComponents.Views
@using MedRec.CommonComponents.Views.Validators
@using MedRec.Entity.Enums
@using MedRec.Entity.Extensions
@using MedRec.MedicalVisit.BusinessObjects.DTOs
@using MedRec.MedicalVisit.BusinessObjects.Validator
@using MedRec.MedicalVisit.ViewModels.Models
@using MedRec.MedicalVisit.ViewModels.VM
@using MedRec.CommonComponents.Views.Components
@using MedRec.MedicalVisit.Views.Resources
@using MedRec.Validator.Interfaces
@using Microsoft.AspNetCore.Components.Forms

@inject IModelValidatorHub<UpdateMedicalVisitModel> visitValidator

<EditForm EditContext="_editContext" OnSubmit="SaveChanged" autocomplete="off">

    <ModelValidator T="UpdateMedicalVisitModel"
                    Validator="visitValidator"
                    ValidationRules="vm => UpdateMedicalVisitValidator.Validate((UpdateMedicalVisitDto)vm, VM.Model.DateOfBirth.CalculateAge())" />

    @* ---------- Campos trampa para autofill ---------- *@
    <input autocomplete="username" style="position: absolute; left: -9999px; top: -9999px;" />
    <input autocomplete="current-password" type="password" style="position: absolute; left: -9999px; top: -9999px;" />

    <!-- Contenedor principal: 2 columnas -->
    <div class="medical-visit-form">
        <!-- Panel izquierdo: Datos del paciente -->
        <div class="patient-info-panel">
            <div class="patient-info-item">
                <div class="patient-label">NOMBRE:</div>
                <div class="patient-value">@VM.Model.FullName</div>
            </div>
            <div class="patient-info-item">
                <div class="patient-label">EDAD:</div>
                <div class="patient-value">@VM.Model.DateOfBirth.CalculateFullAge()</div>
            </div>
            <div class="patient-info-item">
                <div class="patient-label">OBRA SOCIAL: @VM.Model.Acronym</div>
                <div class="patient-value">@VM.Model.HealthInsuranceName</div>
            </div>
            <div class="patient-info-item">
                <div class="patient-label">N° CRECENCIAL:</div>
                <div class="patient-value">@VM.Model.HealthInsuranceCard</div>
            </div>
            <div class="patient-info-item">
                <div class="patient-label">N° SOCIO:</div>
                <div class="patient-value">@VM.Model.HealthInsuranceMemberNumber</div>
            </div>
            <div class="patient-info-item">
                <div class="patient-label">PLAN:</div>
                <div class="patient-value">@VM.Model.HealthInsurancePlan</div>
            </div>
        </div>

        <!-- Panel derecho: Formulario (contiene ambas secciones) -->
        <div class="form-content-panel">
            <!-- Sección: DATOS DE LA VISITA -->
            <fieldset class="form-section visit-data-section">
                <legend>DATOS DE LA VISITA</legend>
                <div class="visit-row">
                    <div class="visit-col short-field">
                        <div class="date-input-wrapper">
                            <label for="visit-date">@MedicalVisitMessages.LabelVisitDate</label>
                            <InputDate id="visit-date"
                                       @bind-Value="VM.Model.VisitDate"
                                       class="date-input"
                                       readonly="@IsReadOnly" />
                        </div>
                        <ValidationMessage For="() => VM.Model.VisitDate" class="validation-message" />
                    </div>

                    <div class="visit-col long-field">
                        <div class="input-reason-wrapper">
                            <label for="reason">@MedicalVisitMessages.LabelVisitReason</label>
                            <InputText id="reason"
                                       @bind-value="VM.Model.Reason">
                            </InputText>
                        </div>
                        <ValidationMessage For="() => VM.Model.Reason" class="validation-message" />
                    </div>
                </div>
            </fieldset>

            <!-- Sección: SIGNOS VITALES Y NOTAS -->
            <fieldset class="form-section vitals-notes-section">
                <legend>SIGNOS VITALES Y NOTAS</legend>
                <div class="vitals-notes-container">
                    <!-- Columna izquierda: signos vitales -->
                    <div class="vitals-column">
                        <div class="vital-row">
                            <label for="systolic">@MedicalVisitMessages.LabelSystPress</label>
                            <InputNumber id="systolic"
                                         @bind-Value="VM.Model.SystolicPressure"
                                         class="vital-input" />
                        </div>
                        <ValidationMessage For="() => VM.Model.SystolicPressure" class="validation-message" />

                        <div class="vital-row">
                            <label for="diastolic">@MedicalVisitMessages.LabelDiastPress</label>
                            <InputNumber id="diastolic"
                                         @bind-Value="VM.Model.DiastolicPressure"
                                         class="vital-input" />
                        </div>
                        <ValidationMessage For="() => VM.Model.DiastolicPressure" class="validation-message" />

                        <div class="vital-row">
                            <label for="pulse">@MedicalVisitMessages.LabelPulsePerMinute</label>
                            <InputNumber id="pulse"
                                         @bind-Value="VM.Model.PulsePerMinute"
                                         class="vital-input" />
                        </div>
                        <ValidationMessage For="() => VM.Model.PulsePerMinute" class="validation-message" />

                        <div class="vital-row">
                            <label for="temperature">@MedicalVisitMessages.LabelTemperature</label>
                            <InputNumber id="temperature"
                                         @bind-Value="VM.Model.Temperature"
                                         class="vital-input" />
                        </div>
                        <ValidationMessage For="() => VM.Model.Temperature" class="validation-message" />
                    </div>

                    <!-- Columna derecha: notas -->
                    <div class="notes-column">
                        <label for="notes">@MedicalVisitMessages.LabelVisitNotes</label>
                        <InputTextArea id="notes"
                                       @bind-Value="VM.Model.Notes"
                                       rows="7"/>
                        <ValidationMessage For="() => VM.Model.Notes" class="validation-message" />
                    </div>
                </div>
            </fieldset>

            <!-- Botones -->
            <div class="button-group">                            
                <button type="button" @onclick="() => HandleButtonClick()">
                    <i class="bi bi-save2"></i> @MedicalVisitMessages.ButtonExit
                </button>

                <button type="submit" disabled="@HasChanges">
                    <i class="bi bi-save2"></i> @MedicalVisitMessages.ButtonSaveMedicalVisit
                </button>
            </div>
        </div>
    </div>

</EditForm>

<!-- Modal de mensajes -->
<ModalComponent Show="@_showModal"
                ShowChanged="@((bool val) => _showModal = val)"
                Title="@_modalTitle"
                Type="@_modalType"
                CenterText="true"
                ShowAcceptButton="_showAcceptButton" 
                ShowCancelButton="_showCancelButton"
                OnAccept="@OnAcceptSave">
    @((MarkupString)VM.InformationMessage)
</ModalComponent>

