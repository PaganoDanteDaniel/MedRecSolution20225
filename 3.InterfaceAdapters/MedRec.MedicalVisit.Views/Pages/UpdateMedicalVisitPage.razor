@page "/medical-visit/detail/{patientId:guid}/{visitId:guid}"
@using MedRec.CommonComponents.Views.Components
@using MedRec.CommonComponents.Views.Exceptions
@using MedRec.CommonComponents.Views.Page
@using MedRec.Entity.Extensions
@using MedRec.MedicalVisit.ViewModels.VM
@using MedRec.MedicalVisit.Views.Components
@using MedRec.MedicalVisit.Views.Resources

@inject NavigationManager Navigation
@inherits OwningComponentBase<UpdateMedicalVisitVMOrchestrator>

<div class="body-content">
    <PageShell FooterMessage="@footerMessage" @ref="pageShellRef" CenterContent="false">
        <HeaderContent>
            <CustomHeader ButtonBackPress="OnBackPressed">
                <HeaderContent>
                    <div class="header-icon">
                        <svg class="icon-header" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect width='8' height='4' x='8' y='2' rx='1' />
                            <path d='M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-5.5' />
                            <path d='M4 13.5V6a2 2 0 0 1 2-2h2' />
                            <path d='M13.378 15.626a1 1 0 1 0-3.004-3.004l-5.01 5.012a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506z' />/>
                        </svg>
                    </div>
                        <h1 class="header-title">@Title</h1>
                </HeaderContent>
            </CustomHeader>
        </HeaderContent>
    
        <ChildContent>
            <UpdateMedicalVisitComponent PatientId="@PatientId"
                                         VM="@VM"
                                         IsReadOnly="@IsReadOnly"
                                         IsEditMode="@IsEditMode"
                                         VisitId="@VisitId"
                                         CloneNow="_cloneNow" />
        </ChildContent>
    
        <ErrorContent Context="context">
            <ExceptionDisplayComponent Exception="context" />
            <button class="btn btn-danger" @onclick="(()=>pageShellRef.Recover())">OK</button>
        </ErrorContent>
    </PageShell>  
</div>

<style>
    :host {
        display: flex;
        flex-direction: column;
        height: 100vh; /* ocupa toda la altura visible de la ventana */
        overflow: hidden; /* evita scroll global */
    }

    /* contenedor principal */
    .body-content {
        display: flex;
        flex-direction: column;
        flex: 1;
        min-height: 100vh;
        overflow: hidden; /* para que el scroll solo sea interno */
        background-color: var(--page-background, #f8f9fa);
    }

    /* footer fijo al fondo */
    .me-footer {
        flex-shrink: 0;
        border-top: 1px solid #ddd;
        padding: 0.75rem 1rem;
        background-color: #f9f9f9;
        text-align: center;
    }
</style>