@page "/patient-control"
@using MedRec.CommonComponents.Views.Components
@using MedRec.CommonComponents.Views.Exceptions
@using MedRec.CommonComponents.Views.Page
@using MedRec.HomeComponent.Views.Helper
@inject NavigationManager NavManager

<PageShell FooterMessage="@footerMessage" @ref="pageShellRef">
    <HeaderContent>
        <CustomHeader ButtonBackPress="HandleBackPressed"
                      ColorA50="--color-green-50"
                      ColorA100="--color-teal-100"
                      ColorB100="--color-green-100"
                      ColorA600="--color-teal-600"
                      ColorB600="--color-green-600">
            <HeaderContent>
                <div class="header-icon">
                    <svg class="icon-header" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                </div>
                <h1 class="header-title">Gestión de Pacientes</h1>
            </HeaderContent>
        </CustomHeader>
    </HeaderContent>

    <ChildContent>
        <div class="md-container">
            <!-- ⭐ NUEVO CONTENEDOR MATERIAL (igual a Home) -->
            <div class="grid-container">
                @foreach (var m in Modules)
                {
                    <div class="@m.CardClass" @onclick="m.Action">
                        <div class="@m.IconClass">
                            @m.IconSvg
                        </div>

                        <h2 class="@m.TitleClass">@m.Title</h2>
                        <p class="card-description">@m.Description</p>
                    </div>
                }
            </div>
        </div> <!-- cierre md-container -->
    </ChildContent>

    <ErrorContent Context="context">
        <ExceptionDisplayComponent Exception="context" />
        <button class="btn btn-danger" @onclick="(()=>pageShellRef.Recover())">OK</button>
    </ErrorContent>
</PageShell>

@code {
    private PageShell pageShellRef;
    private List<MenuModule> Modules = new();
    private string footerMessage = "MedRec Software de gestión médica";

    protected override void OnInitialized()
    {
        Modules = new()
        {
            new MenuModule
            {
                Title = "Alta de Paciente",
                Description = "Registrar nuevo paciente",
                CardClass = "menu-card card-green",
                TitleClass = "card-title title-green",
                IconClass = "card-icon icon-green",
                Action = EventCallback.Factory.Create(this, () => NavManager.NavigateTo("/create-patient")),
                IconSvg = @<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                               <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                               <circle cx="8.5" cy="7" r="4" />
                               <line x1="20" y1="8" x2="20" y2="14" />
                               <line x1="23" y1="11" x2="17" y2="11" />
                           </svg>
            },
            new MenuModule
            {
                Title = "Modificar Paciente",
                Description = "Editar datos de paciente",
                CardClass = "menu-card card-blue",
                TitleClass = "card-title title-blue",
                IconClass = "card-icon icon-blue",
                Action = EventCallback.Factory.Create(this, () => NavManager.NavigateTo("/md-style-preview")),                
                IconSvg = @<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                               <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                               <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                           </svg>
            },
            new MenuModule
            {
                Title = "Eliminar Paciente",
                Description = "Dar de baja un paciente",
                CardClass = "menu-card card-red",
                TitleClass = "card-title title-red",
                IconClass = "card-icon icon-red",
                Action = EventCallback.Factory.Create(this, () => NavManager.NavigateTo("/statistics")),
                IconSvg = @<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                               <polyline points="3 6 5 6 21 6" />
                               <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                               <line x1="10" y1="11" x2="10" y2="17" />
                               <line x1="14" y1="11" x2="14" y2="17" />
                           </svg>
            },
            new MenuModule
            {
                Title = "Listar Pacientes",
                Description = "Mostrar el listado de pacientes",
                CardClass = "menu-card card-pink",
                TitleClass = "card-title title-pink",
                IconClass = "card-icon icon-pink",
                Action = EventCallback.Factory.Create(this, () => NavManager.NavigateTo("/list-patients")),
                IconSvg = @<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                               <path d="M16 5H3" />
                               <path d="M16 12H3"/>
                               <path d="M11 19H3" />
                               <path d="m15 18 2 2 4-4"/>
                           </svg>
            }
        };
    }

    // Handler compatible con EventCallback<int> del CustomHeader
    private Task HandleBackPressed(int _)
    {
        NavManager.NavigateTo("/");
        return Task.CompletedTask;
    }
}

