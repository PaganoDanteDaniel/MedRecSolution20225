@page "/"
@using MedRec.CommonComponents.Views.Components
@using MedRec.CommonComponents.Views.Exceptions
@using MedRec.CommonComponents.Views.Page
@using MedRec.HomeComponent.Views.Helper
@inject NavigationManager Nav
@* var(--menu-background), var(--menu-background-degree)); *@
<PageShell FooterMessage="@footerMessage" @ref="pageShellRef">
    <HeaderContent>
        <CustomHeader ShowBackButton="false">
            <HeaderContent>
                <div class="header-icon">
                    <svg class="header-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M19.414 14.414C21 12.828 22 11.5 22 9.5a5.5 5.5 0 0 0-9.591-3.676.6.6 0 0 1-.818.001A5.5 5.5 0 0 0 2 9.5c0 2.3 1.5 4 3 5.5l5.535 5.362a2 2 0 0 0 2.879.052 2.12 2.12 0 0 0-.004-3 2.124 2.124 0 1 0 3-3 2.124 2.124 0 0 0 3.004 0 2 2 0 0 0 0-2.828l-1.881-1.882a2.41 2.41 0 0 0-3.409 0l-1.71 1.71a2 2 0 0 1-2.828 0 2 2 0 0 1 0-2.828l2.823-2.762" />
                    </svg>
                </div>
                <h1 class="header-title">Software de gestión médica</h1>
            </HeaderContent>
        </CustomHeader>
    </HeaderContent>

    <ChildContent>
        <div class="md-container">
            <div class="grid-container">
                @foreach (var m in Modules)
                {
                    <div class="@m.CardClass" @onclick="m.Action">
                        <div class="@m.IconClass">
                            @m.IconSvg
                        </div>

                        <h2 class="@m.TitleClass">@m.Title</h2>
                        <p class="card-description">@m.Description</p>
                    </div>
                }
            </div>
        </div>
    </ChildContent>

    <ErrorContent Context="context">
        <ExceptionDisplayComponent Exception="context" />
        <button class="btn btn-danger" @onclick="(()=>pageShellRef.Recover())">OK</button>
    </ErrorContent>
</PageShell>

@code {
    private PageShell pageShellRef;
    private List<MenuModule> Modules;
    private string footerMessage = "MedRec Software de gestión médica";

    protected override void OnInitialized()
    {

        Modules = new()
        {
            new MenuModule
            {
                Title = "Gestión de Pacientes",
                Description = "Crear, editar o eliminar información de pacientes",
                CardClass = "menu-card card-green",
                TitleClass = "card-title title-green",
                IconClass = "card-icon icon-green",
                Action = EventCallback.Factory.Create(this, () => Nav.NavigateTo("/patient-control")),
                IconSvg = @<svg class="icon" style="stroke-width:2.5;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                               <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                               <circle cx="9" cy="7" r="4" />
                               <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                               <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                           </svg>
            },

            new MenuModule
            {
                Title = "Agenda Semanal",
                Description = "Gestionar turnos de la semana",
                CardClass = "menu-card card-pink",
                TitleClass = "card-title title-pink",
                IconClass = "card-icon icon-pink",
                Action = EventCallback.Factory.Create(this, () => Nav.NavigateTo("/weekly-schedule")),
                IconSvg = @<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M8 2v4" />
                                <path d="M16 2v4" />
                                <rect width="18" height="18" x="3" y="4" rx="2" />
                                <path d="M3 10h18" />
                                <path d="M8 14h.01" />
                                <path d="M12 14h.01" />
                                <path d="M16 14h.01" />
                                <path d="M8 18h.01" />
                                <path d="M12 18h.01" />
                                <path d="M16 18h.01" />
                            </svg>
            },

            new MenuModule
            {
                Title = "Estadísticas",
                Description = "Datos y métricas del sistema",
                CardClass = "menu-card card-red",
                TitleClass = "card-title title-red",
                IconClass = "card-icon icon-red",
                IconSvg = @<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2" />
                           </svg >
            }
        };
    }
}