@page "/weekly-schedule"
@using MedRec.CommonComponents.Views.Components
@using MedRec.CommonComponents.Views.Exceptions
@using MedRec.MedicalAppointments.Views.Components
@inject NavigationManager NavManager
<style>
    :host {
        display: flex;
        flex-direction: column;
        height: 100vh; /* ocupa toda la altura visible de la ventana */
        overflow: hidden; /* evita scroll global */
    }

    /* contenedor principal */
    .body-content {
        display: flex;
        flex-direction: column;
        flex: 1;
        min-height: 100vh;
        overflow: hidden; /* para que el scroll solo sea interno */
        background-color: var(--page-background, #f8f9fa);
    }

    /* sección que scrollea */
    .scrollable-section {
        flex: 1;
        overflow-y: auto;
        padding: 1rem;
        box-sizing: border-box;
        display: flex;
        justify-content: center; /* centrado horizontal */
        align-items: center; /* centrado vertical */
    }

    /* footer fijo al fondo */
    .me-footer {
        flex-shrink: 0;
        border-top: 1px solid #ddd;
        padding: 0.75rem 1rem;
        background-color: #f9f9f9;
        text-align: center;
    }
</style>
<div class="body-content">
    <CustomHeader ButtonBackPress="HandleBackPressed" >
        <HeaderContent>
            <div class="header-icon">
                <svg class="icon-header" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M16 19h6" />
                    <path d="M16 2v4" />
                    <path d="M19 16v6" />
                    <path d="M21 12.598V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h8.5" />
                    <path d="M3 10h18" />
                    <path d="M8 2v4" />
                </svg>
            </div>
            <h1 class="header-title">Agenda de turnos semanal</h1>
        </HeaderContent>
    </CustomHeader>

    <!-- Zona desplazable class="scrollable-section"-->
    <div class="scrollable-section">
        <ErrorBoundary @ref=ErrorBoundaryRef>
            <ChildContent>
                <AppointmentScheduleComponent />
            </ChildContent>
            <ErrorContent>
                <ExceptionDisplayComponent Exception="context" />
                <button class="btn btn-danger" @onclick=Recover>OK</button>
            </ErrorContent>
        </ErrorBoundary>
    </div>

    <!-- Footer fijo -->
    <div class="me-footer">
        <FooterComponent Message="@footerMessage" />
    </div>
</div>

@code {
    private string footerMessage = "MedRec Software de gestión médica";

    private Task HandleBackPressed(int _)
    {
        NavManager.NavigateTo("/");
        return Task.CompletedTask;
    }

    private void OnMessageFooterChange(string title)
    {
        footerMessage = title;
    }

    ErrorBoundary ErrorBoundaryRef;

    void Recover()
    {
        ErrorBoundaryRef?.Recover();
    }
}
