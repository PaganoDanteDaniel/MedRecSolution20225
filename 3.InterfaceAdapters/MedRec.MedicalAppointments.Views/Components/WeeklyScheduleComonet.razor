@* @page "/agenda" *@

@using MedRec.CommonComponents.Views
@using MedRec.CommonComponents.Views.Components
@using MedRec.MedicalAppointments.ViewModels.VM
@using MedRec.Patients.Views.Components
@using Microsoft.AspNetCore.Components.Forms
@using System.Globalization
@using MedRec.MedicalAppointments.ViewModels.Models
@inherits OwningComponentBase<WeeklyScheduleViewModel>
<style>
    .agenda-container {
        display: flex;
        flex-direction: column;
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
        margin: auto;
        background: #fff;
        border: 1px solid #ccc;
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
        padding: 1rem;
        overflow-x: auto;
    }

    .agenda-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 1rem;
    }

        .agenda-header h2 {
            margin: 0;
            font-size: var(--font-size-header);
        }

    .calendar-selector {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        flex-wrap: wrap;
    }

    .agenda-container .calendar-selector label {
        font-size: var(--font-size-label);
    }

    .agenda-container .calendar-selector input,
    .agenda-container .calendar-selector button {
        padding: var(--space-xs) var(--space-md);
        font-size: var(--font-size-base);
    }

    .agenda-container .calendar-selector button {
        border-radius: 6px;
        background: var(--button-background);
        border: 1px var(--button-border) solid;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 1rem;
        table-layout: fixed;
    }

    thead {
        background-color: #eaeaea;
    }

    th, td {
        border: 1px solid #ccc;
        padding: 0.5rem;
        text-align: center;
        vertical-align: top;
        min-width: clamp(96px, 12vw, 140px);
        cursor: pointer;
        word-wrap: break-word;
        overflow-wrap: anywhere;
    }

    .truncate-22 {
        width: 22ch; /* ancho aproximado de 22 caracteres */
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: inline-block; /* o block según necesites */
    }
        td.asignado {
            background-color: #dff0d8;
        }

        td.pasado {
            background-color: #eee;
            cursor: not-allowed;
        }

        td.modo-mover {
            background-color: #e0f7ff;
            border: 2px dashed blue;
        }

    .modal {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        display: @(mostrarModal ? "flex" : "none");
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

    .modal-content {
        background: white;
        padding: 1rem;
        border-radius: 8px;
        width: 300px;
    }

        .modal-content input {
            width: 100%;
            margin-bottom: 0.5rem;
            padding: 0.4rem;
        }

        .modal-content button {
            margin-right: 0.5rem;
            margin-top: 0.3rem;
        }
    /* --- Scroll sólo en el cuerpo de la agenda --- */
    .agenda-container table {
        border-collapse: collapse;
        width: 100%;
        table-layout: fixed;
    }

    /* Contenedor de scroll en el cuerpo */
    .agenda-container tbody {
        display: block;
        max-height: 65vh; /* altura visible del cuerpo, ajustala a gusto */
        overflow-y: auto; /* activa scroll vertical */
        width: 100%;
    }

    /* Alinea columnas de encabezado y cuerpo */
    .agenda-container thead,
    .agenda-container tr {
        display: table;
        width: 100%;
        table-layout: fixed;
    }

    /* Mantiene el encabezado visible */
    .agenda-container thead {
        position: sticky;
        top: 0;
        z-index: 2;
        background-color: #eaeaea; /* color de fondo del header */
    }

</style>

<div class="agenda-container">
    <div class="agenda-header">
        <h2>@Leyenda</h2>
        <div class="calendar-selector">
            <label>SEMANA:</label>
            <WeekDatePicker OnWeekSelected="OnWeekSelected" />
            @* <button @onclick="AlternarTurno">@BotonTurnoTexto</button> *@
            @if (activeMoveMode)
            {
                <button @onclick="CancelarModoMover">Cancelar mover</button>
            }
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>Horario</th>
                @foreach (var dia in diasSemana)
                {
                    <th>@Capitalizar(dia.ToString("dddd", CultureInfo.CreateSpecificCulture("es-ES"))) @dia.Day</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var fila in _rows)
            {
                <tr>
                    <td>@fila.Time</td>
                    @foreach (var celda in fila.Cells)
                    {
                        var clase = GetCssClass(celda);

                        <td class="@clase"
                            @onclick="() => CeldaClic(celda)">
                            @if (celda.IsPast && celda.Appointment is not null)
                            {
                                <strong class=" truncate-22">@celda.Appointment.PatientName?.ToUpperInvariant()</strong>
                    
                                <br />
                                @celda.Appointment.Reason?.ToUpperInvariant()
                            }
                            else if (celda.Appointment is not null)
                            {
                                <strong class=" truncate-22">@celda.Appointment.PatientName?.ToUpperInvariant()</strong>
                    
                                <br />
                                @celda.Appointment.Reason?.ToUpperInvariant()
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

<ModalComponent Title="SELECTOR DE PACIENTE"
                Show="@mostrarModalPatient"
                Type="ModalType.LargeContent"
                ShowChanged="(value) => mostrarModalPatient = value">

    @if (mostrarModalPatient) 
    {
        <ListPatientsComponent MaxPageButton="3"
                               WithHeight="false"
                               OnPatientSelected="@OnPatientSelected" />
    }
</ModalComponent>

<div class="modal" @onclick="CerrarModalExterior">
    <div class="modal-content" @onclick:stopPropagation="true">
        @if (modalTipo == ModalTipo.Asignar)
        {
            <h3>Asignar turno</h3>
            <InputText @bind-Value="pacienteTemp" placeholder="Paciente" class="form-control" />
            <InputText @bind-Value="motivoTemp" placeholder="Motivo" class="form-control" />
            <button @onclick="SaveAppointmentFromModal">Guardar</button>
            <button @onclick="CerrarModal">Cancelar</button>
        }
        else if (modalTipo == ModalTipo.Gestion && celdaSeleccionada?.Appointment is not null)
        {
            <h3>Turno asignado</h3>
            <p><strong>@celdaSeleccionada.Appointment.PatientName</strong><br />@celdaSeleccionada.Appointment.Reason</p>
            <button @onclick="CancelarTurno">Cancelar turno</button>
            <button @onclick="AbrirModalAsignar">Reasignar paciente</button>
            <button @onclick="ActivarModoMover">Mover a otra fecha</button>
            <button @onclick="CerrarModal">Cerrar</button>
        }
    </div>
</div>

