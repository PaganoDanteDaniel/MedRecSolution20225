@page "/login"
@inject LoginVM VM
@inject NavigationManager NavigationManager

<div class="login-container">
    <div class="login-card">
        <EditForm Model="VM.Model" OnValidSubmit="HandleLogin" autocomplete="off">
            <h2>MedRec</h2>
            <p class="login-subtitle">Iniciar sesión</p>

            <div class="login-row">
                <label for="email">Email</label>
                <InputText id="email" @bind-Value="VM.Model.Email" autocomplete="username" placeholder="tu@email.com" />
            </div>

            <div class="login-row">
                <label for="password">Contraseña</label>
                <InputText id="password" type="password" @bind-Value="VM.Model.Password" autocomplete="current-password" placeholder="••••••••" />
            </div>

            @if (!string.IsNullOrEmpty(VM.InformationMessage))
            {
                <p class="login-error">@VM.InformationMessage</p>
            }

            <button type="submit" disabled="@VM.IsProcessing">
                @(VM.IsProcessing ? "Ingresando..." : "Ingresar")
            </button>
        </EditForm>
    </div>
</div>

@code {
    private async Task HandleLogin()
    {
        await VM.LoginAsync();
        if (VM.InformationMessage == string.Empty)
        {
            // Un login exitoso siempre debe arrancar en la pantalla de inicio, sin importar
            // qué URL haya quedado cargada en el NavigationManager de una sesión anterior
            // (por ejemplo, un admin que cerró sesión estando en "/users/create").
            NavigationManager.NavigateTo("/");
            StateHasChanged();
        }
    }
}
