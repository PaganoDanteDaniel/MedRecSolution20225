@using MedRec.Entity.Enums
@using MedRec.Entity.Extensions
@using MedRec.HealthInsurance.Views.Components
@using MedRec.Patients.BusinessObjects.DTOs
@using MedRec.Patients.ViewModels.Models

@implements IDisposable
@inject IModelValidatorHub<UpdatePatientModel> patientValidator

<EditForm EditContext="_editContext" OnValidSubmit="UpdatePatient">
    <DataAnnotationsValidator />
    <ModelValidator T="UpdatePatientModel"
                    Validator="patientValidator"
                    ValidationRules="p => UpdatePatientValidator.Validate((UpdatePatientDto)p, validateId: true)" />
 
    <div class="update-patient-form">
        @* ---------- Campos trampa para capturar autofill de Chromium ---------- *@
        <input autocomplete="username" style="position: absolute; left: -9999px; top: -9999px;" />
        <input autocomplete="current-password" type="password" style="position: absolute; left: -9999px; top: -9999px;" />
        <div class="update-patient-row">

            <div class="update-patient-col">
                <label for="firstName">@UpdatePatientMessages.FirstNameLabel</label>
                <InputText id="firstName"
                           @bind-value="VM.Model.FirstName"
                           @bind-value:after="() => OnFieldChanged(() => VM.Model.FirstName)"
                           autocomplete="new-firstname"
                           readonly
                           onfocus="this.removeAttribute('readonly');"
                           class="my-input uppercase-input"
                           style="width: 90%;" />
                <ValidationMessage For="() => VM.Model.FirstName" class="validation-message" />
            </div>
            <div class="update-patient-col">
                <label for="lastName">@UpdatePatientMessages.LastNameLabel</label>
                <input id="lastName" 
                       @bind="VM.Model.LastName"
                       @bind:after="() => OnFieldChanged(() => VM.Model.LastName)"
                       autocomplete="new-lastname"
                       readonly
                       onfocus="this.removeAttribute('readonly');"
                       class="uppercase-input" 
                       style="width: 90%;"/>
                <ValidationMessage For="() => VM.Model.LastName" class="validation-message" />
            </div>
        </div>
        
        <div class="update-patient-row">
            <div class="update-patient-col">
                <label for="documentNumber">@UpdatePatientMessages.DocumentNumberLabel</label>
                <input id="documentNumber" 
                           maxlength="8"
                           @bind="VM.Model.DocumentNumber"
                           @bind:after="() => OnFieldChanged(() => VM.Model.DocumentNumber)"
                           autocomplete="new-documentNumber"
                           readonly
                           onfocus="this.removeAttribute('readonly');"
                           class="uppercase-input" 
                           style="width: 40%;"/>
                <ValidationMessage For="() => VM.Model.DocumentNumber" class="validation-message" />
            </div>            
            <div class="update-patient-col">
                <label for="dateOfBirth">@UpdatePatientMessages.DateOfBirthLabel</label>
                <div>
                    <InputDate id="dateOfBirth"
                               @bind-Value="VM.Model.DateOfBirth"
                               @bind-Value:after="() => OnFieldChanged(() => VM.Model.DateOfBirth)"
                               style="width: 40%"
                               autocomplete="off" />
                               <span><label>@VM.Model.DateOfBirth.CalculateFullAge()</label></span>
                    <ValidationMessage For="() => VM.Model.DateOfBirth" class="validation-message" />
                </div>
            </div>
        </div>

        <div class="update-patient-row">
            <div class="update-patient-col">
                <label for="phoneNumber">@UpdatePatientMessages.PhoneNumberLabel</label>
                <input id="phoneNumber" 
                   maxlength="13"
                   @bind="VM.Model.PhoneNumber"
                   @bind:after="() => OnFieldChanged(() => VM.Model.PhoneNumber)"
                   autocomplete="new-phoneNumber"
                   readonly
                   onfocus="this.removeAttribute('readonly');"
                   class="uppercase-input" 
                   style="width: 50%;"/>
                <ValidationMessage For="() => VM.Model.PhoneNumber" class="validation-message" />
            </div>
            <div class="update-patient-col">
                <label for="address">@UpdatePatientMessages.AddresLabel</label>
                <input id="address" 
                   @bind="VM.Model.Address"
                   @bind:after="() => OnFieldChanged(() => VM.Model.Address)"
                   autocomplete="new-address"
                   readonly
                   onfocus="this.removeAttribute('readonly');"
                   class="uppercase-input" 
                   style="width: 90%;" />
                <ValidationMessage For="() => VM.Model.Address" class="validation-message" />
            </div>
        </div>

        <div class="update-patient-row">
            <div class="update-patient-col">
                <label for="email">@UpdatePatientMessages.EmailLabel</label>
                <input id="email" 
                       @bind="VM.Model.Email"
                       @bind:after="() => OnFieldChanged(() => VM.Model.Email)"
                       autocomplete="new-email"
                       readonly
                       onfocus="this.removeAttribute('readonly');"
                       style="width: 75%;" />
                <ValidationMessage For="() => VM.Model.Email" class="validation-message" />
            </div>
            <div class="update-patient-col">
                <label for="biologicalSex">@UpdatePatientMessages.BiologicalSexLabel</label>
                <select id="biologicalSex"
                        @bind="VM.Model.BiologicalSexId"
                        @bind:after="() => OnFieldChanged(() => VM.Model.BiologicalSexId)">
                    @foreach (var sex in Enum.GetValues<BiologicalSex>())
                    {
                        <option value="@sex">@sex.GetDescription()</option>
                    }
                </select>  
            </div>
        </div>

        <div class="update-patient-row">
              <div class="update-patient-col">
                <label for="healthCompany">@UpdatePatientMessages.HealthInsuranceCompanyLabel</label>
                <div class="inline-group">
                    <input id="healthCompany"
                           @bind="VM.Model.SelectedHealthCompanyName"
                           @bind:after="() => OnFieldChanged(() => VM.Model.SelectedHealthCompanyName)"
                           style="width: 85%;"
                           readonly
                           autocomplete="off" />
                    <button type="button" @onclick="() => _healthInsuranceSelectorRef?.Open()">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>
            
            <div class="update-patient-col">
                <label for="HealthInsuranceCard">@UpdatePatientMessages.HealthInsuranceCardLabel</label>
                <input type="text"
                       id="insuranceHealthCard"
                       maxlength="19"
                       value="@_healthInsuranceCardDisplay"
                       @oninput="OnHealthInsuranceCardInput"
                       class="uppercase-input"
                       style="width: 65%;"
                       autocomplete="off" />
                <ValidationMessage For="() => VM.Model.HealthInsuranceCard" class="validation-message" />
            </div>
        </div>

        <div class="update-patient-row">
            <div class="update-patient-col">
                <label for="HealthInsuranceMemberNumber">@UpdatePatientMessages.HealthInsuranceMemberNumberLabel</label>
                <input id="HealthInsuranceMemberNumber"
                       @bind="VM.Model.HealthInsuranceMemberNumber"
                       @bind:after="() => OnFieldChanged(() => VM.Model.HealthInsuranceMemberNumber)"
                       class="uppercase-input"
                       style="width: 53%;"
                       autocomplete="off" />
                <ValidationMessage For="() => VM.Model.HealthInsuranceMemberNumber" class="validation-message" />
            </div>           
            <div class="update-patient-col">
                <label for="HealthInsurancePlan">@UpdatePatientMessages.HealthInsurancePlanLabel</label>
                <input id="HealthInsurancePlan" 
                       @bind="VM.Model.HealthInsurancePlan"
                       @bind:after="() => OnFieldChanged(() => VM.Model.HealthInsurancePlan)"
                       class="uppercase-input" 
                       style="width: 35%;" 
                       autocomplete="off" />
                <ValidationMessage For="() => VM.Model.HealthInsurancePlan" class="validation-message" />
            </div>
        </div>

        <div class="update-patient-row button-group">
            <button type="submit" disabled="@(!HasChanges)">
                <i class="fas fa-check"></i> @UpdatePatientMessages.SubmitButton
            </button>
            @* 
            <button type="button" @onclick="ClearForm">
                <i class="fas fa-eraser"></i> @UpdatePatientMessages.ClearButton
            </button> 
            *@
            <button type="button" @onclick="ExitForm">
                <i class="fas fa-times"></i> @UpdatePatientMessages.ExitButton
            </button>
        </div>
    </div>
</EditForm>

@if (isLoading)
{
    <div style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center; background:rgba(255,255,255,0.6); z-index:1000;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}

<HealthInsuranceSelector @ref="_healthInsuranceSelectorRef"
                         OnSelected="OnHealthCompanySelected" />

@if (_modalNotifier.IsVisible)
{
    <MdMessageModal Visible="true"
                    VisibleChanged="@(v => _modalNotifier.Close())"
                    Type="@_modalNotifier.Type"
                    Title="@_modalNotifier.Title"
                    Message="@_modalNotifier.Message"
                    ShowOk="true"
                    OnOk="() => {
                        
                        if (_modalNotifier.ShouldNavigateAfterClose)
                        {
                            Navigation.NavigateTo(_modalNotifier.NavigationUrl, true);
                        }
                        else
                        {
                            _modalNotifier.Close();
                        }
                    }" />
}

@if (_showConcurrencyModal)
{
   <MdMessageModal Visible="@(_showConcurrencyModal && VM.ConcurrencyConflicts.Count > 0)"
                VisibleChanged="@(async (visible) => OnConcurrencyShowChanged(visible))"
                Type="ModalType.MessageWarning"
                Title="@UpdatePatientMessages.ConcurrencyConflictTitle"
                ShowOk="false"
                ShowCancel="true"
                ShowRetry="true"
                ShowDelete="false"
                OnCancel="OnConcurrencyCancel"
                OnRetry="RetryWithResolvedValues">
    <Body>
        <div class="concurrency-panel md-card bg-surface-container-high p-2">
             <p class="text-body-medium mb-3">@UpdatePatientMessages.ConcurrencyConflictMessage</p>

            @for (var i = 0; i < VM.ConcurrencyConflicts.Count; i++)
            {
                var conflict = VM.ConcurrencyConflicts[i];
                <div class="concurrency-field mb-3">
                    <div class="text-label-large mb-1">@GetFriendlyLabel(conflict.Label)</div>
                    <div class="d-flex flex-column flex-md-row gap-2">
                        <div class="flex-grow-1">
                            <small class="text-body-small text-secondary">@UpdatePatientMessages.DbValueLabel:</small>
                            <div class="text-body-medium">@conflict.DbValueDisplay</div>
                        </div>
                        <div class="flex-grow-1">
                            <small class="text-body-small text-secondary">@UpdatePatientMessages.UserValueLabel:</small>
                            <div class="text-body-medium">@conflict.UserValueDisplay</div>
                        </div>
                        <div class="d-flex flex-column justify-content-end">
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="radio"
                                       name="@($"conf-res-{i}")"
                                       value="KeepDbValue"
                                       checked="@(conflict.Resolution.ToString() == "KeepDbValue")"
                                       @onchange="@(e => OnResolutionChanged(conflict, e.Value?.ToString()))" />
                                <label class="form-check-label">@UpdatePatientMessages.KeepDbValueOption</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="radio"
                                       name="@($"conf-res-{i}")"
                                       value="KeepUserValue"
                                       checked="@(conflict.Resolution.ToString() == "KeepUserValue")"
                                       @onchange="@(e => OnResolutionChanged(conflict, e.Value?.ToString()))" />
                                <label class="form-check-label">@UpdatePatientMessages.KeepUserValueOption</label>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </Body>
</MdMessageModal> 
}

