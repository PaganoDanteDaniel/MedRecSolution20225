@using MedRec.Entity.Extensions
@using MedRec.HealthInsurance.Views.Components
@using MedRec.Patients.BusinessObjects.DTOs
@using MedRec.Patients.ViewModels.Models
@using Microsoft.AspNetCore.Components.Forms

@inject IModelValidatorHub<CreatePatientModel> patientValidator

<EditForm EditContext="_editContext" OnValidSubmit="AddPatient" autocomplete="off" >
    <DataAnnotationsValidator />
    <ModelValidator T = "CreatePatientModel"
                    Validator = "patientValidator"
                    ValidationRules = "vm => CreatePatientValidator.Validate((CreatePatientDto)vm)" />

  <div class="new-patient-form">
    @* ---------- Campos trampa para capturar autofill de Chromium ---------- *@
    <input autocomplete="username" style="position: absolute; left: -9999px; top: -9999px;" />
    <input autocomplete="current-password" type="password" style="position: absolute; left: -9999px; top: -9999px;" />

  
        <div class="new-patient-row">
            <div class="new-patient-col">
                <label for="firstName">@CreatePatientMessages.FirstNameLabel</label>
                <InputText id="firstName"
                           @bind-value="VM.Model.FirstName"
                           autocomplete="new-firstname"
                           readonly
                           onfocus="this.removeAttribute('readonly');"
                           class="uppercase-input"
                           style="width: 90%;" />
                <ValidationMessage For="() => VM.Model.FirstName" class="validation-message" />
            </div>
            <div class="new-patient-col">
                <label for="lastName">@CreatePatientMessages.LastNameLabel</label>
                <InputText id="lastName"
                           @bind-value="VM.Model.LastName"
                           autocomplete="new-lastname"
                           readonly
                           onfocus="this.removeAttribute('readonly');"
                           class="uppercase-input" 
                           style="width: 90%;" />
                <ValidationMessage For="() => VM.Model.LastName" class="validation-message" />
            </div>
        </div>
        <div class="new-patient-row">
            <div class="new-patient-col">
                <label for="documentNumber">@CreatePatientMessages.DocumentNumberLabel</label>
                <InputText id="documentNumber"
                           @bind-value="VM.Model.DocumentNumber"
                           class="uppercase-input"
                           style="width: 40%"
                           maxlength="8" />
                <ValidationMessage For="() => VM.Model.DocumentNumber" class="validation-message" />
            </div>
            <div class="new-patient-col">
                <label for="dateOfBirth">@CreatePatientMessages.DateOfBirthLabel</label>
                <div>
                    <InputDate id="dateOfBirth"
                               @bind-Value="VM.Model.DateOfBirth"
                               style="width: 40%"
                               autocomplete="off" />
                    <span><label>@VM.Model.DateOfBirth.CalculateFullAge()</label></span>
                    <ValidationMessage For="() => VM.Model.DateOfBirth" class="validation-message" />
                </div>

            </div>
        </div>
        <div class="new-patient-row">
            <div class="new-patient-col">
                <label for="_email">@CreatePatientMessages.EmailLabel</label>
                <InputText id="email"
                           @bind-value="VM.Model.Email"
                           autocomplete="new-email"
                           readonly
                           onfocus="this.removeAttribute('readonly');"
                           style="width: 75%;" 
                        />
                <ValidationMessage For="() => VM.Model.Email" class="validation-message" />
            </div>
            <div class="new-patient-col">
                <label for="phoneNumber">@CreatePatientMessages.PhoneNumberLabel</label>
                <InputText id="phoneNumber"
                           maxlength="13"
                           @bind-value="VM.Model.PhoneNumber"
                           autocomplete="new-phoneNumber"
                           readonly
                           onfocus="this.removeAttribute('readonly');"
                           class="uppercase-input" 
                           style="width: 50%;" 
                        />
                <ValidationMessage For="() => VM.Model.PhoneNumber" class="validation-message" />
            </div>
        </div>
        <div class="new-patient-row">
            <div class="new-patient-col">
                <label for="healthCompany">@CreatePatientMessages.InsuranceHealthCompanyLabel</label>
                <div class="inline-group">
                    <InputText id="healthCompany"
                               @bind-value="VM.Model.SelectedHealthCompanyName"
                               readonly="readonly"
                               placeholder="Seleccione una obra social"
                               style="width: 85%;" />
                    <button type="button" @onclick="() => _healthInsuranceSelectorRef?.Open()">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>
   
            <div class="new-patient-col">
                <label for="insuranceHealthCard">@CreatePatientMessages.InsuranceHealthCardLabel</label>
                <input type="text"
                       id="insuranceHealthCard"
                       maxlength="19"
                       value="@_healthInsuranceCardDisplay"
                       @oninput="OnHealthInsuranceCardInput"
                       class="uppercase-input"
                       style="width: 65%;"
                       autocomplete="off" />
                <ValidationMessage For="() => VM.Model.HealthInsuranceCard" class="validation-message" />
            </div>
        </div>
        <div class="new-patient-row">
            <div class="new-patient-col">
                <label for="insuranceHealthMemberNumber">@CreatePatientMessages.InsuranceHealthMemberNumberLabel</label>
                <InputText id="insuranceHealthMemberNumber"
                           @bind-value="VM.Model.HealthInsuranceMemberNumber"
                           class="uppercase-input"
                           style="width: 53%;" />
                <ValidationMessage For="() => VM.Model.HealthInsuranceMemberNumber" class="validation-message" />
            </div>            
            <div class="new-patient-col">
                <label for="insuranceHealthPlan">@CreatePatientMessages.InsuranceHealthPlanLabel</label>
                <InputText id="insuranceHealthPlan"
                           @bind-value = "VM.Model.HealthInsurancePlan"
                           class = "uppercase-input" 
                           style = "width: 35%;" 
                        />
                <ValidationMessage For="() => VM.Model.HealthInsurancePlan" class="validation-message" />
            </div>
        </div>
        <div class="new-patient-row button-group">
            <button type="submit">
                <i class="fas fa-check"></i> @CreatePatientMessages.SubmitButton
            </button>
            <button type="button" @onclick="ExitForm">
                <i class="fas fa-times"></i> SALIR
            </button>
        </div>
  </div>  
    
</EditForm>

  @if (isLoading)
    {
        <div style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center; background:rgba(255,255,255,0.6); z-index:1000;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }

<HealthInsuranceSelector @ref="_healthInsuranceSelectorRef"
                         OnSelected="OnHealthCompanySelected" />
@if (_modalNotifier.IsVisible)
{
    <!-- ===== MODAL: Notificaciones del paciente (éxito/error/navegación) ===== -->
    <MdMessageModal Visible="true"
                VisibleChanged="@(v => _modalNotifier.Close())"
                Type="@_modalNotifier.Type"
                Title="@_modalNotifier.Title"
                Message="@_modalNotifier.Message"
                CloseOnOverlayClick="true"
                ShowOk="true"
                OnOk="() => {
                    _modalNotifier.Close();
                    if(_modalNotifier.ShouldNavigateAfterClose)
                        Navigation.NavigateTo(_modalNotifier.NavigationUrl,true);
                }" />
}