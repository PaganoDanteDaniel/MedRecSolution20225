
@using MedRec.CommonComponents.Views.Helpers
@using Microsoft.AspNetCore.Components.Forms
@using MedRec.Patients.BusinessObjects.DTOs
@using Microsoft.AspNetCore.Components

@inherits OwningComponentBase<PatientsListVM>

<div class="container@(WithHeight ? " with-height" : "")">
    @if (isLoading)
    {
        <div style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center; background:rgba(255,255,255,0.6); z-index:1000;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    <div class="search-section">
        <SearchAndAddComponent LabelText="@ListPatientsMessages.FilterLabel"
                           Placeholder="@ListPatientsMessages.PlaceholderFilterInput"
                           ButtonText="AGREGAR"
                           @bind-Value="Filter"
                           OnButtonClick="OnAddNewPatient" 
                           ShowButton/>
    </div>

    <div class="table-container">
        <TableComponent TItem="PatientSummaryDto"
                        Items="pagedPatients.ToList()"
                        OnRowClick="SelectPatient"
                        OnEdit="OnEditPatient"
                        OnDelete="OnDeletePatient"
                        ShowActionsColumn="ShowActionsColumn">
                        <ColGroup>
                            <colgroup>
                                <col style="width: 30%"> <!-- APELLIDO Y NOMBRE -->
                                <col style="width: 10%"> <!-- DNI -->
                                <col style="width: 15%"> <!-- TELÉFONO -->
                                @if (ShowActionsColumn) { <col style="width: 25%"> } <!-- ACCIONES -->
                            </colgroup>
                        </ColGroup>
                        <FullHeaderTemplate>
                            <thead>
                                <tr>
                                    <th scope="col">@ListPatientsMessages.HeadLastNameText y @ListPatientsMessages.HeadNameText</th>
                                    <th scope="col" class="header-center">@ListPatientsMessages.HeadDocumentNumberText</th>
                                    <th scope="col" class="header-center">@ListPatientsMessages.HeadPhoneText</th>
                                    @if (ShowActionsColumn) {<th scope="col" class="actions">@ListPatientsMessages.HeadActionsText</th> }
                                </tr>
                            </thead>
                        </FullHeaderTemplate>
                        <RowTemplate Context="patient">
                            <td>@patient.LastName, @patient.FirstName</td>
                            <td class="number-type">@FormatStringAsNumber.WithDots(patient.DocumentNumber)</td>
                            <td class="number-type">@patient.PhoneNumber</td>
                        </RowTemplate>
                        <AdditionalAction Context="patient">
                            <a href="javascript:void(0);"
                               @onclick="() => OnAddMedicalVisit(patient)"
                               @onclick:stopPropagation="true">

                                <i class="bi bi-clipboard-pulse text-info mx-1"
                                   data-bs-toggle="tooltip"
                                   data-bs-placement="top"
                                   title="Registrar Visita Médica">
                                </i>
                            </a>
                        </AdditionalAction>
                    </TableComponent>
    </div>
    
    <div class="pagination-section">
        <PaginationComponent CurrentPage="@_paginationDto.CurrentPage" 
            TotalPages="@_totalPages" 
            PageChanged="HandlePageChanged"
            MaxPageButton="MaxPageButton"/>
    </div>
</div>


@if (_modalNotifier.IsVisible)
{
    <MdMessageModal Visible="true"
                    VisibleChanged="@(v => _modalNotifier.IsVisible = v)"
                    Type="@_modalNotifier.Type"
                    Title="@_modalNotifier.Title"
                    Message="@_modalNotifier.Message"
                    Body="@_modalNotifier.ModalBody"
                    CloseOnOverlayClick="@_modalNotifier.CloseOnOverlayClick"
                    ShowOk="@_modalNotifier.ShowOk"
                    ShowCancel="@_modalNotifier.ShowCancel"
                    ShowDelete="@_modalNotifier.ShowDelete"
                    ShowRetry="@_modalNotifier.ShowRetry"
                    OnOk="_onOkCallback"
                    OnCancel="_onCancelCallback"
                    OnDelete="_onDeleteCallback"
                    OnRetry="_onRetryCallback" />
}

<script >
    // Inicializa los tooltips
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
      });
</script >

