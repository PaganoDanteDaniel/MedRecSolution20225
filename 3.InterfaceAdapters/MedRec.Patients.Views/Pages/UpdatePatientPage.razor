@page "/patient/update"
@page "/patient/update/{patientId:guid}"
@using MedRec.CommonComponents.Views.Page

@inherits OwningComponentBase<UpdatePatientVM>

<div class="body-content">

    <PageShell FooterMessage="@footerMessage" @ref="pageShellRef" CenterContent="true">
        <HeaderContent>
            <CustomHeader ButtonBackPress="OnBackPressed">
                <HeaderContent>
                    <div class="header-icon">
                        <svg class="icon-header" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                        </svg>
                    </div>
                        <h1 class="header-title">@UpdatePatientMessages.UpdatePatientPageTitle</h1>
                </HeaderContent>
            </CustomHeader>
        </HeaderContent>
    
        <ChildContent>
            @if (PatientId != Guid.Empty)
            {
                <UpdatePatientComponent VM="VM"
                                        PatientId="PatientId" />
            }
            
        </ChildContent>
    
        <ErrorContent Context="context">
            <ExceptionDisplayComponent Exception="context" />
            <button class="btn btn-danger" @onclick="(()=>pageShellRef.Recover())">OK</button>
        </ErrorContent>
    </PageShell>

    @* ======== MODAL PARA MOSTRAR LISTADO DE PACIENTES Y NOTIFICACIONES =======*@
    <MdMessageModal Visible="_showModal"
                    VisibleChanged="@(v => _showModal = v)"
                    CloseOnOverlayClick="false"
                    Type="@ModalType"
                    Title="Seleccione paciente a editar"
                    Body="@ModalBody"
                    Message="@ModalMessage"
                    ShowOk="@ShowOk"
                    ShowCancel="@ShowCancel"
                    ShowDelete="@ShowDelete"
                    ShowRetry="@ShowRetry">
    </MdMessageModal>

</div>

@if (_isLoading)
{
    <div style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center; background:rgba(255,255,255,0.6); z-index:1000;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}