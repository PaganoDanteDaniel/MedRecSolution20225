@page "/contact"

<div class="contact-container">
    <h1>Dante Pagano Soluciones Informáticas</h1>

    <div class="contact-details">
        <p>
            <strong>Email:</strong>
            <a href="mailto:pagano.dante@gmail.com" class="contact-link">pagano.dante@gmail.com</a>
        </p>
        <p>
            <strong>Teléfono / WhatsApp:</strong>
            <a href="https://wa.me/5492625439197" target="_blank" class="contact-link">+54 9 2625 439197</a>
        </p>
    </div>

    <div class="software-info">
        <h2>Sobre nuestro software</h2>
