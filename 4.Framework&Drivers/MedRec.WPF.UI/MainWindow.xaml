<?xml version="1.0" encoding="UTF-8" ?>
<Window
    x:Class="MedRec.WPF.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/winfx/2006/xaml/presentation/blazor"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MedRec.WPF.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    WindowState="Maximized"
    Height="600"
    Width="800"
    mc:Ignorable="d">
    <Grid>
        <b:BlazorWebView x:Name="blazorWebView"
            HostPage="wwwroot/index.html"
            Services="{x:Static local:Startup.Services}">
            <b:BlazorWebView.RootComponents>
                <b:RootComponent
                    ComponentType="{x:Type local:AppShell}"
                    Selector="#app"/>
            </b:BlazorWebView.RootComponents>
        </b:BlazorWebView>
    </Grid>
</Window>
