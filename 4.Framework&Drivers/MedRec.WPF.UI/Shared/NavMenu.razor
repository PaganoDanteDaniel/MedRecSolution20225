@using MedRec.Identity.BusinessObjects.Constants
@using MedRec.Identity.BusinessObjects.Interfaces.Services
@inject ISessionService SessionService

<div class="sidebar @NavClass">
    <div class="nav-header">
        <button class="hamburger-btn" @onclick="ToggleNav">
            @if (_isCollapsed)
            {
                <i class="bi bi-arrow-bar-right"></i>
            }
            else
            {
                <i class="bi bi-arrow-bar-left"></i>
            }
        </button>
        @if (!_isCollapsed)
        {
            <span class="app-name">MedRec App</span>
        }
    </div>

    @if (SessionService.CurrentUser is not null)
    {
        <div class="nav-user">
            @if (!_isCollapsed)
            {
                <span>@SessionService.CurrentUser.FullName</span>
            }
            <button class="logout-btn" @onclick="Logout" title="Cerrar sesión">
                <i class="bi bi-box-arrow-right"></i>
            </button>
        </div>
    }

    <ul class="nav-links">
        <li>
            <a href="/">
                <i class="bi bi-house"></i>
                @if (!_isCollapsed)
                {
                    <span>Lista Pacientes</span>
                }
            </a>
        </li>
        <li>
            <a href="/create-patient">
                <i class="bi bi-person-plus"></i>
                @if (!_isCollapsed)
                {
                    <span>Nuevo Paciente</span>
                }
            </a>
        </li>
        <li>
            <a href="/weekly-schedule">
                <i class="bi bi-calendar3"></i>
                @if (!_isCollapsed)
                {
                    <span>Agenda</span>
                }
            </a>
        </li>
        @if (SessionService.CurrentUser?.Permissions.Contains(SystemPermissions.Users_View) == true)
        {
            <li>
                <a href="/users">
                    <i class="bi bi-people"></i>
                    @if (!_isCollapsed)
                    {
                        <span>Usuarios</span>
                    }
                </a>
            </li>
        }
        <li>
            <a href="/contact">
                <i class="bi bi-envelope"></i>
                @if (!_isCollapsed)
                {
                    <span>Contacto</span>
                }
            </a>
        </li>
    </ul>
</div>

@code {
    private async Task Logout()
    {
        await SessionService.LogoutAsync();
    }
}