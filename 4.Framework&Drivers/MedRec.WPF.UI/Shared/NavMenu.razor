

<div class="sidebar @NavClass">
    <div class="nav-header">
        <button class="hamburger-btn" @onclick="ToggleNav">
            @if (_isCollapsed)
            {
                <!-- Cuando está colapsado -->
                @* <i class="bi bi-three-dots-vertical"></i> *@
                <i class="bi bi-arrow-bar-right"></i>
            }
            else
            {
                <!-- Cuando está expandido -->
                @* <i class="bi bi-list"></i> *@
                <i class="bi bi-arrow-bar-left"></i>
            }
        </button>
        @if (!_isCollapsed)
        {
            <span class="app-name">MedRec App</span>
        }
    </div>

    <ul class="nav-links">
        <li>
            <a href="/">
                <i class="bi bi-people"></i>
                @if (!_isCollapsed)
                {
                    <span>Lista Pacientes</span>
                }
            </a>
        </li>
        <li>
            <a href="/patient-menu">
                <i class="bi bi-person-plus"></i>
                @if (!_isCollapsed)
                {
                    <span>Nuevo Paciente</span>
                }
            </a>
        </li>
        <li>
            <a href="/agenda">
                <i class="bi bi-calendar3"></i>
                @if (!_isCollapsed)
                {
                    <span>Agenda</span>
                }
            </a>
        </li>
        <li>
            <a href="/contact">
                <i class="bi bi-envelope"></i>
                @if (!_isCollapsed)
                {
                    <span>Contacto</span>
                }
            </a>
        </li>
    </ul>
</div>

